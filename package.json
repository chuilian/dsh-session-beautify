{
  "name": "dsh-session-beautify",
  "version": "0.2.0",
  "description": "Sidebar appearance for DSH: per-session and per-workspace title colour, text glow, font weight and text shadow, kept in the browser. · DSH 侧边栏美化：给每个会话标题与每个工作区名称单独设置颜色、文字发光、字体粗细与文字阴影。",
  "icon": "assets/icon-180.png",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon-180.png"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "docs",
    "locale/*.json",
    "assets/*.png"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:core": "node --test --test-concurrency=1 \"tests/core.test.js\"",
    "test:bundle": "node --test --test-concurrency=1 \"tests/bundle.test.js\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "session",
    "workspace",
    "appearance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuilian/dsh-session-beautify.git"
  },
  "homepage": "https://github.com/chuilian/dsh-session-beautify#readme",
  "bugs": {
    "url": "https://github.com/chuilian/dsh-session-beautify/issues"
  }
}
